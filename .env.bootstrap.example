APP_NAME="MAIIC IFRS 9"
APP_ENV=bootstrap
APP_DEBUG=true
TELESCOPE_ENABLED=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maiic_ifrs9_bootstrap
DB_USERNAME=root

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_CLUSTER=mt1
PUSHER_APP_HOST=localhost
PUSHER_APP_SCHEME=http
PUSHER_APP_USE_TLS=false
LARAVEL_WEBSOCKETS_PORT=6001

VITE_PUSHER_ENABLED=false
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_APP_USE_TLS="${PUSHER_APP_USE_TLS}"
VITE_PUSHER_APP_PORT="${LARAVEL_WEBSOCKETS_PORT}"
VITE_HOST=localhost
VITE_PORT=5173

# --- Login CAPTCHA (self-hosted, offline) ---
CAPTCHA_ENABLED=true

# --- HTTPS / TLS hardening (see docs/SSL_SETUP.md) ---
# Turn these on only after a certificate is installed on the server.
FORCE_HTTPS=false
HSTS_ENABLED=false
# SESSION_SECURE_COOKIE=true

# Manual screenshot pipeline (php artisan manual:screenshots). The CAPTCHA
# bypass code only works when APP_ENV=local.
MANUAL_SHOT_EMAIL=admin@localhost.com
DEBUGBAR_ENABLED=false
APP_KEY=
DB_PASSWORD=
MANUAL_SHOT_PASSWORD=
MANUAL_SHOT_CAPTCHA=
EBANKER_FEED_API_TOKEN=
